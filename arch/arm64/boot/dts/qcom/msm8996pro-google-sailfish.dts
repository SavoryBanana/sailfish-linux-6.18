/dts-v1/;

#include "msm8996pro.dtsi"
#include "pm8994.dtsi"
#include "pmi8994.dtsi"
#include "pmi8996.dtsi"
#include <dt-bindings/input/input.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>

/ {
	model = "Google Pixel (Sailfish)";
	compatible = "google,sailfish", "qcom,msm8996pro", "qcom,msm8996";
	chassis-type = "handset";
	qcom,msm-id = <420 0x10001>, <421 0x10001>;
	qcom,board-id = <0x80 0>, <3 0>;
	qcom,pmic-id = <0x20009 0x10013 0x0 0x0>;

	/* 4GB LPDDR4 physical memory map */
	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x80000000>,
		      <0x1 0x00000000 0x0 0x7e550000>;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		framebuffer0: framebuffer@c0000000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0xc0000000 0x0 (1080 * 1920 * 3)>;
			width = <1080>;
			height = <1920>;
			stride = <(1080 * 3)>;
			format = "r8g8b8";
			memory-region = <&cont_splash_mem>;
		};
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		cont_splash_mem: memory@c0000000 {
			reg = <0x0 0xc0000000 0x0 0x3200000>;
			no-map;
		};

		dfps_data_mem: memory@83400000 {
			reg = <0x0 0x83400000 0x0 0x100000>;
			no-map;
		};

		ramoops@83500000 {
			compatible = "ramoops";
			reg = <0x0 0x83500000 0x0 0x100000>;
			record-size = <0x40000>;
			console-size = <0x80000>;
			pmsg-size = <0x40000>;
		};

		tz_bldr_mem: memory@83600000 {
			reg = <0x0 0x83600000 0x0 0xa00000>;
			no-map;
		};
	};

	etm {
		status = "disabled";
	};

	gpio-keys {
		compatible = "gpio-keys";

		key-vol-up {
			label = "Volume Up";
			gpios = <&pm8994_gpios 2 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
			wakeup-source;
			debounce-interval = <15>;
		};
	};
};

&soc {
	watchdog@9830000 {
		compatible = "qcom,kpss-wdt";
		reg = <0x09830000 0x1000>;
		clocks = <&sleep_clk>;
		timeout-sec = <30>;
	};

	/* Retail Sailfish TrustZone XPU-locks QDSS/CoreSight debug blocks */
	stm@3002000 { status = "disabled"; };
	tpiu@3020000 { status = "disabled"; };
	funnel@3021000 { status = "disabled"; };
	funnel@3022000 { status = "disabled"; };
	funnel@3023000 { status = "disabled"; };
	funnel@3025000 { status = "disabled"; };
	replicator@3026000 { status = "disabled"; };
	etf@3027000 { status = "disabled"; };
	etr@3028000 { status = "disabled"; };
	debug@3810000 { status = "disabled"; };
	etm@3840000 { status = "disabled"; };
	debug@3910000 { status = "disabled"; };
	etm@3940000 { status = "disabled"; };
	funnel@39b0000 { status = "disabled"; };
	debug@3a10000 { status = "disabled"; };
	etm@3a40000 { status = "disabled"; };
	debug@3b10000 { status = "disabled"; };
	etm@3b40000 { status = "disabled"; };
	funnel@3bb0000 { status = "disabled"; };
	funnel@3bc0000 { status = "disabled"; };
};

&tlmm {
	/* gpio0..3 (blsp_spi1) are XPU-locked by TrustZone for the fingerprint sensor */
	gpio-reserved-ranges = <0 4>;
};

&pm8994_resin {
	linux,code = <KEY_VOLUMEDOWN>;
	status = "okay";
};

/*
 * Keep native display/MMSS clocks, unused SMMUs, TZ-owned crypto/PRNG,
 * and unused BAM DMA controllers disabled during early bring-up so
 * continuous splash stays intact and TZ XPU regions are untouched.
 */
&mmcc {
	status = "disabled";
};

&mnoc {
	status = "disabled";
};

/* Keep CPU/CBF clocks at bootloader nominal rate until Kryo voltage regulators are configured */
&kryocc {
	status = "disabled";
};

&cbf {
	status = "disabled";
};

&rng {
	status = "disabled";
};

&blsp1_dma {
	status = "disabled";
};

&blsp2_dma {
	status = "disabled";
};

&slimbam {
	status = "disabled";
};

&mdp_smmu {
	status = "disabled";
};

&mdss {
	status = "disabled";
};

&adreno_smmu {
	status = "disabled";
};

&venus_smmu {
	status = "disabled";
};

&vfe_smmu {
	status = "disabled";
};

&lpass_q6_smmu {
	status = "disabled";
};

&cryptobam {
	status = "disabled";
};

&crypto {
	status = "disabled";
};

&blsp2_uart2 {
	status = "disabled";
};

&ufshc {
	vcc-supply = <&vreg_l20a_2p95>;
	vccq-supply = <&vreg_l25a_1p2>;
	vccq2-supply = <&vreg_s4a_1p8>;
	vdd-hba-supply = <&vreg_l25a_1p2>;

	vcc-max-microamp = <600000>;
	vccq-max-microamp = <450000>;
	vccq2-max-microamp = <450000>;

	status = "okay";
};

&ufsphy {
	status = "okay";
	vdda-phy-supply = <&vreg_l28a_0p925>;
	vdda-pll-supply = <&vreg_l12a_1p8>;
};

&usb3 {
	status = "okay";
	qcom,select-utmi-as-pipe-clk;
};

&usb3_dwc3 {
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
	phys = <&hsusb_phy1>;
	phy-names = "usb2-phy";
	snps,is-utmi-l1-suspend;
	snps,usb2-gadget-lpm-disable;
};

&hsusb_phy1 {
	status = "okay";
	vdd-supply = <&vreg_l28a_0p925>;
	vdda-pll-supply = <&vreg_l12a_1p8>;
	vdda-phy-dpdm-supply = <&vreg_l24a_3p075>;
};

&rpm_requests {
	regulators-0 {
		compatible = "qcom,rpm-pm8994-regulators";

		vreg_s4a_1p8: s4 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-always-on;
		};

		vreg_l12a_1p8: l12 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
		};

		vreg_l20a_2p95: l20 {
			regulator-min-microvolt = <2950000>;
			regulator-max-microvolt = <2950000>;
			regulator-allow-set-load;
		};

		vreg_l24a_3p075: l24 {
			regulator-min-microvolt = <3075000>;
			regulator-max-microvolt = <3075000>;
		};

		vreg_l25a_1p2: l25 {
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-allow-set-load;
		};

		vreg_l28a_0p925: l28 {
			regulator-min-microvolt = <925000>;
			regulator-max-microvolt = <925000>;
			regulator-allow-set-load;
		};
	};
};

